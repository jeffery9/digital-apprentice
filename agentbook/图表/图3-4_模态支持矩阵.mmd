%% 图 3-4｜模态支持矩阵（第 3 章 3.5 节）
%% 刻意不点名任何产品：档位是 L1/L2 知识，"谁在哪一格"是 L3 事实，须用表 3-2 探针实测
%% 行＝五类非文本模态；列＝四个能力档位；每格＝架构含义
%%{init: {"flowchart": {"nodeSpacing": 70, "rankSpacing": 90, "padding": 18, "htmlLabels": false}}}%%
flowchart TB
    subgraph DOC["文档图像（扫描件·合同·报表截图）"]
        direction LR
        D0["档 0 不支持<br/>→ 自建 OCR/视觉检索管线"]
        D1["档 1 整体理解<br/>→ 可做分类粗筛"]
        D2["档 2 理解＋定位<br/>→ 可做精确抽取（页码/区域）"]
        D3["档 3 原生实时<br/>→ 流式文档审阅"]
        D0 --- D1 --- D2 --- D3
    end
    subgraph IMG["自然图像（照片·设计稿·现场图）"]
        direction LR
        I0["档 0 → 需外部视觉模型"]
        I1["档 1 描述与打标"]
        I2["档 2 目标定位（框）"]
        I3["档 3 实时视频流理解"]
        I0 --- I1 --- I2 --- I3
    end
    subgraph AUD["音频（语音输入/输出）"]
        direction LR
        U0["档 0 → 外挂 ASR/TTS"]
        U1["档 1 转写后当文本用"]
        U2["档 2 带时间戳与说话人"]
        U3["档 3 原生语音进出·可打断"]
        U0 --- U1 --- U2 --- U3
    end
    subgraph SCR["屏幕（界面元素）"]
        direction LR
        S0["档 0 不支持"]
        S1["档 1 只能描述界面"]
        S2["档 2 给出可点击元素坐标<br/>→ 屏幕-动作循环的前提（第 14 章）"]
        S3["档 3 连续操作＋动态界面适应"]
        S0 --- S1 --- S2 --- S3
    end
    NOTE["限制条件与档位同等重要：单请求图像数与分辨率上限（超限会被静默降采样）·文档页数上限·音频时长与采样率·是否支持该模态的**输出**·非文本输入的 token 折算方式（决定模态预算，第 13 章）"]
    DOC --- IMG --- AUD --- SCR --- NOTE
    classDef cell fill:#fff,stroke:#33475b,stroke-width:1.1px,color:#1a1a1a
    classDef key fill:#eef1f5,stroke:#1a1a1a,stroke-width:1.6px,color:#1a1a1a
    class D0,D1,D3,I0,I1,I2,I3,U0,U1,U2,U3,S0,S1,S3 cell
    class D2,S2,NOTE key
