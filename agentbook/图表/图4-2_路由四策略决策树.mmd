%% 图 4-2｜路由四策略决策树（第 4 章 4.5 节）
%% 三条判断：硬约束 → 难度可预测吗 → 质量有兜底吗；每条分支标注该策略的主要代价
%%{init: {"flowchart": {"nodeSpacing": 70, "rankSpacing": 90, "padding": 18, "htmlLabels": false}}}%%
flowchart TB
    S(["一次模型调用请求（带调用点标识）"]) --> Q1{"有硬约束吗？<br/>合规分区 / 模态 / 延迟上限"}
    Q1 -- 有 --> R1["规则路由：过滤候选集<br/>代价：覆盖窄，规则会膨胀"]
    Q1 -- 无 --> R1b["规则路由：仍先过一遍默认约束"]
    R1 --> Q2{"难度可预测吗？"}
    R1b --> Q2
    Q2 -- "可预测且有标注" --> C1["预测（分类器）路由<br/>代价：需数千条标注＋延迟税＋漂移重训"]
    Q2 -- "可预测但无标注" --> C2["语义（嵌入）路由<br/>代价：阈值脆、需漂移监控；相似度≠难度"]
    Q2 -- 不可预测 --> Q3{"有可自动判定的质量标准吗？"}
    Q3 -- 有 --> C3["级联升级：先便宜模型，判别器不通过再升级<br/>代价：升级请求双跑；u>0.5 就不划算"]
    Q3 -- 没有 --> C4["先补评估器（第 18 章）<br/>在此之前：规则＋固定档位，不要用概率组件兜底"]
    C1 --> OUT(["选定模型（记录理由与候选集）"])
    C2 --> OUT
    C3 --> OUT
    C4 --> OUT
    NOTE["生产收敛形态＝分层叠加：规则（不允许）→ 语义/分类器（大概率）→ 级联（实际错了怎么办）"]
    OUT -.-> NOTE
    classDef q fill:#fff,stroke:#1a1a1a,stroke-width:1.4px,color:#1a1a1a
    classDef a fill:#fff,stroke:#33475b,stroke-width:1.1px,color:#1a1a1a
    classDef n fill:#eef1f5,stroke:#33475b,stroke-width:1.2px,color:#1a1a1a,stroke-dasharray:4 3
    class Q1,Q2,Q3 q
    class R1,R1b,C1,C2,C3,C4,S,OUT a
    class NOTE n
