%% 图 3-2｜推理模型吸收了什么、留下了什么（第 3 章 3.3 节）
%% 左＝被模型内部能力吸收的外部编排手段；右＝因此变得更重要的架构手段
%% 中间竖线的判断：吸收 ≠ 消失，从"你必须做"变成"你必须验证模型做了"
%%{init: {"flowchart": {"nodeSpacing": 70, "rankSpacing": 90, "padding": 18, "htmlLabels": false}}}%%
flowchart LR
    subgraph ABS["被模型吸收（不再是你的编排职责）"]
        direction TB
        A1["显式思维链提示<br/>（'让我们一步步想'）"]
        A2["单轮内自我检查与多方案比较<br/>（外部 Self-Refine 循环的一部分）"]
        A3["简单的先规划后作答<br/>（单次调用内完成）"]
        A4["一部分参数错误自纠"]
        A1 --- A2 --- A3 --- A4
    end
    MID["吸收 ≠ 消失<br/>从'你必须做'<br/>变成'你必须验证模型做了'"]
    subgraph KEEP["因此更重要（架构职责加重）"]
        direction TB
        K1["预算与停止条件多一维：思考 token<br/>步数上限约束力下降 → 墙钟与金额上限成必须"]
        K2["上下文管理更紧张：思维链要不要留在历史里"]
        K3["工具契约清晰度收益变大：强模型会'创造性误用'含糊描述"]
        K4["评估必要性上升：失败形态是'论证流畅、结论错误'"]
        K5["可复现性要单独实测：temperature=0 ≠ 确定性"]
        K1 --- K2 --- K3 --- K4 --- K5
    end
    ABS --> MID --> KEEP
    classDef box fill:#fff,stroke:#33475b,stroke-width:1.2px,color:#1a1a1a
    classDef mid fill:#eef1f5,stroke:#1a1a1a,stroke-width:1.8px,color:#1a1a1a
    class A1,A2,A3,A4,K1,K2,K3,K4,K5 box
    class MID mid
