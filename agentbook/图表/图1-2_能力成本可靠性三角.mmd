%% 图 1-2｜能力—成本—可靠性三角（第 1 章）
%% 导读：三条边标注耦合机制与驱动因子；三角内部是工程可推动的前沿。曲线为 p^n 示意，非实测数据。
%% 黑白印刷自检：不依赖颜色区分，三边均有文字标注。
flowchart TB
    CAP(["能力 capability<br/>能处理的任务复杂度上限<br/>驱动因子：自主性档位"])
    COST(["成本 cost<br/>单位任务 token／延迟／人工兜底<br/>驱动因子：迭代次数 × 上下文长度"])
    REL(["可靠性 reliability<br/>成功率稳定性与故障可归因性<br/>驱动因子：步数 × 副作用可逆性"])

    CAP -- "边①：token 对轮数平方级<br/>T(n) ≈ 400n² + 800n" --- COST
    CAP -- "边②：误差复利<br/>任务成功率 = pⁿ（0.9⁵⁰ ≈ 0.52%）" --- REL
    COST -- "边③：重试／级联双跑／校验／人审<br/>每项可靠性手段都在烧钱" --- REL

    FRONTIER["三角内部＝工程可推动的前沿<br/>四种推进手段（全部是架构手段，无一是换模型）：<br/>① 剥离可编排部分 → 减步数（第10章）<br/>② 上下文预算与压缩 → 减缓平方膨胀（第6章）<br/>③ 模型池与能力路由 → 不加成本提高 p（第4章）<br/>④ 检查点／重规划／反思 → 削弱步骤相关性（第9·15·16章）"]

    CAP --- FRONTIER
    COST --- FRONTIER
    REL --- FRONTIER

    classDef node fill:#fff,stroke:#33475b,stroke-width:1.6px,color:#1a1a1a
    classDef inner fill:#f2f5f9,stroke:#33475b,stroke-width:1px,color:#1a1a1a
    class CAP,COST,REL node
    class FRONTIER inner
