%% 图 10-2｜工作流五模式结构对照（第 10 章）
%%{init: {"flowchart": {"nodeSpacing": 70, "rankSpacing": 90, "padding": 18, "htmlLabels": false}}}%%
flowchart TB
    subgraph P1["① 路由"]
        direction LR
        A1["分类器"] --> A2["分支注册表"] --> A3["独立管线×N"]
        A2 -.-> A4["兜底分支"]
    end
    subgraph P2["② 并行扇出"]
        direction LR
        B1["同一输入"] --> B2["分支1"] & B3["分支2"] & B4["分支N"]
        B2 & B3 & B4 --> B5["聚合器：投票/择优/拼接"]
    end
    subgraph P3["③ 流水线"]
        direction LR
        C1["步骤1"] -->|检查点| C2["步骤2"] -->|检查点| C3["步骤3"]
        C2 -.失败回退.-> C1
    end
    subgraph P4["④ 辩论"]
        direction LR
        D1["立场A"] <--> D2["立场B"] --> D3["裁判：依据＝轨迹"]
    end
    subgraph P5["⑤ 生成-评估-优化"]
        direction LR
        E1["生成"] --> E2["评估"] --> E3["修订"]
        E3 -.-> E1
        E2 -->|轮次上限闸口| E4["交付最优候选"]
    end
    NOTE["模式可嵌套：路由分支内可再跑流水线"]
    P1 & P2 & P3 & P4 & P5 ~~~ NOTE

    classDef col fill:#fff,stroke:#33475b,stroke-width:1.2px,color:#1a1a1a
    classDef note fill:#f2f5f9,stroke:#c0392b,stroke-width:1.4px,color:#1a1a1a,stroke-dasharray:5 3
    class A1,A2,A3,A4,B1,B2,B3,B4,B5,C1,C2,C3,D1,D2,D3,E1,E2,E3,E4 col
    class NOTE note
