        R4["④ ＋自然图像<br/>单轮:L1a｜多轮:L2｜长任务:L3｜常驻:L5"]
        R5["⑤ ＋音频<br/>单轮:L3｜多轮:L4｜长任务:L4｜常驻:L5"]
