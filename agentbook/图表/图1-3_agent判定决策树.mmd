%% 图 1-3｜Agent 判定决策树（第 1 章）
%% 导读：五问顺序即优先级——前两问安全性门禁，第三四问可行性门禁，第五问工程能力门禁。
flowchart TD
    START(["一个候选任务簇"]) --> Q1
    Q1{"问1 分支集合能画完吗？<br/>（控制流所有权）"}
    Q1 -- "能画完" --> WF(["用 workflow<br/>更便宜、更可测、更好维护"])
    Q1 -- "画不完" --> Q2
    Q2{"问2 错误代价可承受<br/>且有降级出口吗？<br/>（副作用可逆性）"}
    Q2 -- "否" --> RO(["只给只读权限<br/>或先建审批门／降级路径<br/>（第15·17章）"])
    Q2 -- "是" --> Q3
    Q3{"问3 延迟预算够 n 轮往返吗？"}
    Q3 -- "否，且用户在线" --> ASYNC(["流式反馈或转异步<br/>n≥20 转后台任务（第16章）<br/>实时语音另论（第14章）"])
    Q3 -- "是" --> Q4
    Q4{"问4 任务状态装得进<br/>一个上下文窗口吗？"}
    Q4 -- "否" --> HORIZON(["需要时程架构：<br/>检查点·上下文重建·进度事件流<br/>复杂度与成本上一档（第16章）"])
    Q4 -- "是" --> Q5
    Q5{"问5 有能力评估它吗？<br/>任务集＋可判定标准＋轨迹留存"}
    Q5 -- "否" --> EVAL(["先建评估，再谈 agent<br/>（第18章）"])
    Q5 -- "是" --> GO(["可以上 agent<br/>推荐起点：让 agent 帮人看，不替人做"])
    HORIZON -.->|"补齐时程架构后回到问5"| Q5

    classDef gate fill:#fff,stroke:#33475b,stroke-width:1.4px,color:#1a1a1a
    classDef stop fill:#f2f5f9,stroke:#33475b,stroke-width:1px,color:#1a1a1a
    classDef go fill:#fff,stroke:#33475b,stroke-width:2.4px,color:#1a1a1a
    class Q1,Q2,Q3,Q4,Q5,START gate
    class WF,RO,ASYNC,HORIZON,EVAL stop
    class GO go
