%% 图 14-1｜屏幕-动作循环与双通道观察（第 14 章）
%% 截图＋（可得时）无障碍树双通道输入 → 受限动作 schema → 沙箱执行 → 显式验证（等待条件，绝不固定 sleep）。
flowchart LR
    subgraph OBS["观察（双通道，IR 纪律沿用 13.4）"]
        direction TB
        SHOT["截图<br/>（低保真界面投影，恒可用）"]
        AX["无障碍树 / 元素列表<br/>（理想形态，Web 页面常残缺）"]
    end

    DEC["决策<br/>受限动作 schema：click / type / scroll / key<br/>禁止自由文本动作 · 连续坐标→误点率天然高"]

    EXE["执行<br/>沙箱内（15.5 三件套：隔离·录制·急停）"]

    VER{"显式验证<br/>等待条件：目标状态特征出现或超时<br/>绝不用固定 sleep 赌时序"}

    NEXT["下一步 / 每 N 步全局状态自检（防漂移累积）"]
    GATE["不可逆动作确认门<br/>提交/支付/删除类先过门"]
    FAILH["超时→重试或升级人工<br/>（失败可归因：录全程）"]

    OBS --> DEC --> EXE --> VER
    VER -- "通过" --> GATE --> NEXT
    VER -- "未达预期状态" --> FAILH
    FAILH -.-> DEC
    NEXT -. "下一张截图（警惕：页面滞后于动作＝时序竞争）" .-> OBS

    classDef node fill:#fff,stroke:#33475b,stroke-width:1.4px,color:#1a1a1a
    classDef gate fill:#fdf6ec,stroke:#c0392b,stroke-width:1.4px,color:#1a1a1a
    classDef fail fill:#f2f5f9,stroke:#33475b,stroke-width:1.2px,color:#1a1a1a,stroke-dasharray:5 3
    class SHOT,AX,DEC,EXE,NEXT node
    class VER,GATE gate
    class FAILH fail
